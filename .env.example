# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Google Workspace / Classroom Add-on Configuration
# Obtained from Google Cloud Console & Workspace Marketplace SDK
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CLASSROOM_ADDON_PROJECT_NUMBER=your-gcp-project-number

# Educational LLM Providers
# 1. Google Gemini API (Recommended for Classroom integration)
GEMINI_API_KEY=your-gemini-api-key-here

# 2. Anthropic Claude API (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 3. OpenAI ChatGPT API (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here

# Default fallback model provider if none specified: 'gemini', 'claude', or 'openai'
DEFAULT_LLM_PROVIDER=gemini
